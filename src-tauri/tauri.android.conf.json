{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noland Connect",
  "identifier": "com.noland.connect",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Noland Connect",
        "width": 390,
        "height": 844
      }
    ],
    "security": {
      "capabilities": ["android"]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "externalBin": [],
    "resources": []
  },
  "plugins": {
    "updater": null
  }
}
